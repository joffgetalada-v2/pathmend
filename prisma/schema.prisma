// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

// Mirror of the native Shopify UrlRedirect we created — the live redirect
// always lives in Shopify (never proxied through the app); this row powers
// search-free listing joins, the free-plan cap, drift detection ("redirects
// never silently disappear"), and analytics.
model Redirect {
  id         String   @id @default(cuid())
  shop       String
  shopifyGid String
  path       String
  target     String
  // manual | not_found_fix | csv_import | migration | auto_heal
  source     String   @default("manual")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, path])
  @@index([shop, createdAt])
}

// One row per (shop, normalized 404 path); repeat hits bump counters.
model NotFoundEvent {
  id          String   @id @default(cuid())
  shop        String
  path        String
  referrer    String?
  // desktop | mobile | tablet | unknown
  deviceType  String   @default("unknown")
  hits        Int      @default(1)
  // unresolved | resolved | ignored
  status      String   @default("unresolved")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([shop, path])
  @@index([shop, status, lastSeenAt])
}

model ShopSettings {
  shop           String  @id
  captureEnabled Boolean @default(true)
}

// Wildcard/regex rules that auto-heal new 404s into concrete native
// redirects. The rule itself never serves traffic — matches always
// materialize a real Shopify urlRedirect (source "auto_heal").
model PatternRule {
  id            String    @id @default(cuid())
  shop          String
  // wildcard | regex
  kind          String
  pattern       String
  target        String
  enabled       Boolean   @default(true)
  // Count of redirects materialized from this rule.
  hits          Int       @default(0)
  lastMatchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop, enabled])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

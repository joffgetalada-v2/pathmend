# Local dev uses SQLite; production sets this to a Postgres connection string.
DATABASE_URL="file:dev.sqlite"

# Set by `shopify app dev` / the Partner Dashboard — do not hardcode:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=write_online_store_navigation

# The theme app extension UUID (from `shopify app deploy`) — enables the
# onboarding deep-link to pre-select the app embed. Optional; falls back gracefully.
# SHOPIFY_THEME_EXTENSION_ID=

# Force billing test mode on/off (default: test off in production only).
# BILLING_TEST_MODE=
